@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/FlexiProofs.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>


}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="FlexiService" ng-controller="FlexiController" ng-init="LoadReimburseEdit('@Html.Raw(ViewBag.Action)','@Html.Raw(ViewBag.Title)')" >

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4" ng-if="FlexiBenefitProofModel.status!=4 || FlexiBenefitProofModel.status!=6">Update Reimbursement</div>
                                <div class="h4" ng-if="FlexiBenefitProofModel.status==4">View Reimbursement</div>

                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">


                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="tab-content">




                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">


                                <!-- USING THE GRID COMPLEX -->
                                <div class="col-12">
                                    <div class="example">
                                        <div class="description">
                                            <div class="description-text">
                                                <div class="row no-gutters align-items-center justify-content-between">

                                                    <div class="list-title text-muted">


                                                    </div>


                                                </div>
                                            </div>
                                            <div class="toggle-source-preview">

                                            </div>
                                        </div>
                                        <div class="source-preview-wrapper">
                                            <div class="preview">
                                                <div class="preview-elements">
                                                    <div class="container">
                                                        <form name="myform">

                                                            <div class="row">

                                                                <div class="form-group col-md-8">
                                                                     


                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>
                                                            </div>
                                                            <div class="row">

                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Benefit Name</label>


                                                                    {{FlexiBenefitProofModel.benefitName}}
                                                                    <input type="hidden" ng-model="FlexiBenefitProofModel.benefitName">
                                                                    <input type="hidden" ng-model="FlexiBenefitProofModel.benefitProofID">
                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Provider Name</label>


                                                                    <input type="text" class="form-control" name="FlexiBenefitProofModel.providerName" ng-model="FlexiBenefitProofModel.providerName">
                                                                    <input type="hidden" ng-model="FlexiBenefitProofModel.empID">
                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Bill ID</label>


                                                                    <input type="text" class="form-control" name="FlexiBenefitProofModel.billID" ng-model="FlexiBenefitProofModel.billID">



                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Bill Date</label>
                                                                     

                                                                    <input type="text" class="form-control" name="FlexiBenefitProofModel.billDate" ng-model="FlexiBenefitProofModel.billDate">
                                                                     

                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Bill Amount</label>

                                                                    <input type="text" class="form-control" name="FlexiBenefitProofModel.billAmount" ng-model="FlexiBenefitProofModel.billAmount">


                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Approved Amount</label>


                                                                    {{FlexiBenefitProofModel.approvedAmount}}

                                                                </div>
                                                            </div>

                                                            <div class="row">

                                                                <div class="form-group col-md-8">
                                                                    <label class="col-form-label">Comments</label>


                                                                    <input type="text" class="form-control" name="FlexiBenefitProofModel.comments" ng-model="FlexiBenefitProofModel.comments">

                                                                </div>
                                                            </div>

                                                             <div class="row">

                                                                <div class="form-group col-md-8">
                                                                    <div class="row p-xl-1" ng-if="msg!=''">

                                                                        <div class="preview">
                                                                            <div class="preview-elements">
                                                                                <div class="alert alert-warning alert-dismissible fade show"
                                                                                     role="alert">
                                                                                    <button type="button" class="close" data-dismiss="alert"
                                                                                            aria-label="Close">
                                                                                        <span aria-hidden="true">&times;</span>
                                                                                    </button>
                                                                                    <strong>{{msg}}</strong>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>


                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>
                                                            </div>


                                                            <div class="row">
                                                                <div class="form-group col-md-6">
                                                                    <label class="col-form-label">Upload file</label>

                                                                    <input type="file" id="file" ngf-select ng-model="fileModelList.fileItem" ngf-pattern="'*'"
                                                                           ngf-change="clearImageErrorMsgs()" />


                                                                </div>

                                                            </div>


                                                            <div class="row">
                                                                <div class="form-group col-md-2" ng-if="FlexiBenefitProofModel.status!=4">
                                                                    <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="SaveReimbursement(FlexiBenefitProofModel)">
                                                                        Submit
                                                                    </button>
                                                                </div>

                                                                <div class="form-group col-md-4">

                                                                </div>

                                                            </div>
                                                            <div class="row">


                                                                <div class="form-group col-12 bg-blue-100">
                                                                    <label>Uploaded Files:</label>

                                                                </div>
                                                                <div class="form-group col-12">

                                                                    <div class="col-3" ng-repeat="TaxDocModel in taxDocList">

                                                                        <div>
                                                                            {{TaxDocModel.filename}}
                                                                            <button type="submit" class="btn btn-icon btn-sm" ng-click="downlaodFile(TaxDocModel)"> <i class="icon icon-download"></i></button>
                                                                            <button type="submit" class="btn btn-icon btn-sm" ng-click="DeleteFile(TaxDocModel)">  <i class="icon-delete"></i></button>


                                                                        </div>

                                                                    </div>
                                                                </div>


                                                            </div>

                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <!-- USING THE GRID COMPLEX -->



                            </div>


                            <!-- / SUB CONTENT -->



                        </div>

                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>