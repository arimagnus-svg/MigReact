@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>
    <script type="text/javascript" src="~/lib/js/FileSaver.js"></script>

    <script src="~/lib/appJS/FlexiSetup.js"></script>




}



<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-orders" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="FlexiService" ng-controller="FlexiController" ng-init="LoadFlexiBeneSummary()">

                <!-- HEADER -->
                <div class="header  bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-12 col-sm">

                        <div class="logo row no-gutters align-items-start">

                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cart-outline s-6"></i>
                            </div>

                            <div class="logo-text">
                                <div class="h4">Benefit Declaration Summary</div>
                                <div class=""></div>
                            </div>

                        </div>
                    </div>
                    <!-- / APP TITLE -->
                    <!-- SEARCH -->
                    <div class="col search-wrapper pl-2">

                        <div class="input-group">

                            <span class="input-group-btn">
                                <button type="button" class="btn btn-icon">
                                    <i class="icon icon-magnify"></i>
                                </button>
                            </span>

                            <input id="orders-search-input" type="text" class="form-control"
                                   placeholder="Search"
                                   aria-label="Search" />

                        </div>
                    </div>
                    <!-- / SEARCH -->
                </div>
                <!-- / HEADER -->

                <div class="page-content-card">

                    <table id="formSummary-table" class="table dataTable">

                        <thead>

                            <tr>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Employee Name</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Year</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">BenefitName</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Approved Amount</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Declared Amount</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Status</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Action</span>
                                    </div>
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr ng-repeat="FlexiBenefitModel in modelList" tableload>
                                <td>{{FlexiBenefitModel.empName}}</td>
                                <td>{{FlexiBenefitModel.finYear}}</td>
                                <td>{{FlexiBenefitModel.benefitName}}</td>
                                <td>{{FlexiBenefitModel.approvedAmount}}</td>
                                <td>
                                    <span class="badge badge-info">{{FlexiBenefitModel.declaredAmount}}</span>
                                </td>
                                <td class="date">
                                    <span class="badge badge-success" ng-if="FlexiBenefitModel.status>0"> Declared</span>
                                    <span class="badge badge-success" ng-if="FlexiBenefitModel.status<1"> Pending</span>
                                </td>
                                <td>
                                    <a href="EditFlexiBene?BeneName={{FlexiBenefitModel.benefitName}}&&Ad={{FlexiBenefitModel.employeeID}}">
                                        <i class="icon icon-dots-horizontal s-4"></i>
                                    </a>
                                </td>

                            </tr>

                        </tbody>
                    </table>
                    <div>
                        &nbsp;  <button class="btn-warning" ng-click="DownloadExcel(modelList)"><i class="icon icon-download s-4"></i>Export to Excel</button>


                    </div>
                </div>
            </div>
            <!-- / CONTENT -->
        </div>

    </div>
</div>