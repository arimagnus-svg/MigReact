@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/angular-route.js"></script>

    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>


    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
    <script src="~/lib/appJS/FlexiSetup.js"></script>


}


<div class="content-wrapper">

    <div class="content">

        <div id="contacts" class="page-layout simple left-sidebar-floating">


            <!-- CONTENT -->
            <!-- HEADER -->
            <div class="page-header bg-primary text-auto row no-gutters align-items-center justify-content-between p-4 p-sm-6">

                <div class="col">

                    <div class="row no-gutters align-items-center flex-nowrap">

                        <button type="button"
                                class="sidebar-toggle-button btn btn-icon d-inline-block d-lg-none mr-2"
                                data-fuse-bar-toggle="contacts-sidebar">
                            <i class="icon icon-menu"></i>
                        </button>

                        <!-- APP TITLE -->
                        <div class="logo row no-gutters align-items-center flex-nowrap">
                            <span class="logo-icon mr-4">
                             </span>
                            <span class="logo-text h4"> Declare Flexi Benefits</span>
                        </div>
                    </div>
                    <!-- / APP TITLE -->
                </div>

                <!-- SEARCH -->
                <div class="col search-wrapper">

                    <div class="input-group">

                       

                    </div>
                </div>
                <!-- / SEARCH -->
            </div>
            <!-- / HEADER -->
            <!-- CONTENT -->
            <div class="page-content-wrapper">

                <div class="page-content  p-6 p-sm-6" ng-app="FlexiService" ng-controller="FlexiController" ng-init="LoadFlexiDetails()">


 
                        <!-- WIDGET GROUP -->
                        <div class="widget-group row " >


                            <!-- WIDGET 2 -->
                            <div class="col-12 col-sm-6 col-xl-4 p-3" ng-repeat="FlexiBenefitModel in flexiBeneList" >

                                <div class="widget widget{{$index}} card">

                                    <div class="widget-header pl-4 pr-2 row no-gutters align-items-center justify-content-between">

                                        <div class="col">
                                            <span class="h6"> {{FlexiBenefitModel.benefitName}}</span>
                                        </div>

                                        
                                    </div>

                                    <div class="widget-content pt-2 pb-8 d-flex flex-column align-items-center justify-content-center">
                                        <div class="title text-green">Allocation Value</div>
                                        <div class="sub-title h6 text-muted">{{FlexiBenefitModel.approvedAmount}}</div>
                                    </div>

                                    <div class="widget-footer p-4 bg-faded row no-gutters align-items-center">
                                        <span class="text-muted">  {{FlexiBenefitModel.declaredAmount}}</span>
                                        <span class="ml-2" ng-if="FlexiBenefitModel.status>=1">Declared</span>
                                        <span class="ml-2" ng-if="FlexiBenefitModel.status<1">
                                            Pending
                                            <a data-ng-href="@Url.Action("EditFlexiBene", "FlexiService")?BeneName={{FlexiBenefitModel.benefitName}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </span>

                                    </div>
                                </div>
                            </div>
                            <!-- / WIDGET 2 -->

                            <div class="col-12 form-check has-danger" ng-if="modelList.length<=0">

                                <br />
                                <label class="form-check-label"><span>Benefit details not found</span></label>
                            </div>

                        </div>
                        <!-- / WIDGET GROUP -->



                    </div>
                    <!-- / CONTENT -->

                </div>

        </div>


    </div>
</div>