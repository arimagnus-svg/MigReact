@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/FlexiSetup.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>


}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>
             
            <!-- CONTENT -->
            <div class="page-content" ng-app="FlexiService" ng-controller="FlexiController" ng-init="LoadFlexiBeneDataEdit('@Html.Raw(ViewBag.Action)','@Html.Raw(ViewBag.Title)')">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Edit Flexi Benefit Details</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">


                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="tab-content">




                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">


                                <!-- USING THE GRID COMPLEX -->
                                <div class="col-12">
                                    <div class="example">
                                        <div class="description">
                                            <div class="description-text">
                                                <div class="row no-gutters align-items-center justify-content-between">

                                                    <div class="list-title text-muted">


                                                    </div>


                                                </div>
                                            </div>
                                            <div class="toggle-source-preview">

                                            </div>
                                        </div>
                                        <div class="source-preview-wrapper">
                                            <div class="preview">
                                                <div class="preview-elements">
                                                    <div class="container">
                                                        <form name="myform">


                                                            <div class="row">

                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Benefit Name</label>


                                                                    <input  type="text" readonly class="form-control" name="FlexiBenefitModel.benefitName" ng-model="FlexiBenefitModel.benefitName">

                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Approved Amount</label>


                                                                    <input type="text" readonly  class="form-control" name="FlexiBenefitModel.approvedAmount" ng-model="FlexiBenefitModel.approvedAmount">

                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Declared Amount</label>


                                                                    <input type="text" class="form-control" name="FlexiBenefitModel.declaredAmount" ng-model="FlexiBenefitModel.declaredAmount">

                                                                     

                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Comments (Optional)</label>


                                                                    <input type="text"  class="form-control" name="FlexiBenefitModel.comments" ng-model="FlexiBenefitModel.comments">

                                                                </div>
                                                            </div>


                                                            

                                                            <div class="row">
                                                                <div class="form-group col-md-1">
                                                                    <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="SaveBeneData(FlexiBenefitModel)">
                                                                        Update
                                                                    </button>


                                                                </div>
                                                                 
                                                                <div class="form-group col-md-4">

                                                                </div>

                                                            </div>


                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <!-- USING THE GRID COMPLEX -->



                            </div>


                            <!-- / SUB CONTENT -->



                        </div>

                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>