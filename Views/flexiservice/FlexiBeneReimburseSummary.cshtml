@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/FlexiProofs.js"></script>





}

<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-orders" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="FlexiService" ng-controller="FlexiController" ng-init="LoadFlexiBeneProofSummary('@Html.Raw(ViewBag.Action)')">

                <!-- HEADER -->
                <div class="header  bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-12 col-sm">

                        <div class="logo row no-gutters align-items-start">

                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cards-variant s-6"></i>
                            </div>

                            <div class="logo-text">
                                <div class="h4">Benefit Submission Summary</div>
                                <div class=""></div>
                            </div>

                        </div>
                    </div>
                    <!-- / APP TITLE -->
                    <!-- SEARCH -->
                    <div class="col search-wrapper pl-2">
                        <div class="col-6 col-sm"></div>
                        <div class="col-6 col-sm ">

                            <a href="/FlexiService/AddReimbursement" class="btn btn-secondary">Add Reimbursement</a>

                        </div>
                    </div>
                    <!-- / SEARCH -->
                </div>
                <!-- / HEADER -->

                <div class="page-content-card">

                    <table id="formSummary-table" class="table dataTable">

                        <thead>

                            <tr>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Year</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Emp ID</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Benefit Name</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Provider Name</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Bill Date</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Bill Amount</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Submitted Date</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Approved Amount</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Status</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Action</span>
                                    </div>
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr ng-repeat="FlexiBenefitProofModel in modelList" tableload>
                                <td>{{FlexiBenefitProofModel.finYear}}</td>
                                <td>{{FlexiBenefitProofModel.empID}}</td>

                                <td>{{FlexiBenefitProofModel.benefitName}}</td>
                                <td>{{FlexiBenefitProofModel.providerName}}</td>
                                <td>{{FlexiBenefitProofModel.billDate}}</td>
                                <td>{{FlexiBenefitProofModel.billAmount}}</td>
                                <td>{{FlexiBenefitProofModel.submittedDate}} </td>

                                <td>
                                    <span class="badge badge-info">{{FlexiBenefitProofModel.approvedAmount}}</span>
                                </td>
                                <td class="date">

                                    <span class="badge badge-info" ng-if="FlexiBenefitProofModel.status<3"> Submitted</span>
                                    <span class="badge badge-warning" ng-if="FlexiBenefitProofModel.status==3"> Deleted</span>

                                    <span class="badge badge-success" ng-if="FlexiBenefitProofModel.status==4"> Approvved</span>
                                    <span class="badge badge-warning" ng-if="FlexiBenefitProofModel.status==5"> Rejected</span>
                                    <span class="badge badge-success" ng-if="FlexiBenefitProofModel.status==6"> Reimbursed</span>

                                </td>
                                <td>
                                    <a href="EditReimbursement?BenefitProofID={{FlexiBenefitProofModel.benefitProofID}}&&Ad={{Action}}">
                                        <i class="icon icon-pencil s-4"></i>
                                    </a>
                                    <a ng-if="FlexiBenefitProofModel.status!=4 && FlexiBenefitProofModel.status!=6" href="" ng-click="DeleteReimbursement(FlexiBenefitProofModel)">
                                        <i class="icon icon-delete s-4"></i>
                                    </a>
                                </td>

                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
            <!-- / CONTENT -->
        </div>

    </div>
</div>