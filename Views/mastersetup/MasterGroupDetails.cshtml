@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/MasterGroupSetupVal.js"></script>

}

<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="MasterGroupSetupApp">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">
                    
                        <!-- APP TITLE -->
                        <div class="col-12 col-sm">

                            <div class="logo row no-gutters align-items-start">
                                <div class="logo-icon mr-3 mt-1">
                                    <i class="icon-cube-outline s-6"></i>
                                </div>
                                <div class="logo-text">
                                    <div class="h4">Master Group Setup</div>
                                    <div class=""></div>
                                </div>
                            </div>

                        </div>
                        <!-- / APP TITLE -->


                        <div class="col-auto">
                            <a href="/MasterSetup/AddNewMasterSetup" class="btn btn-secondary">Add New Group</a>
                        </div>

                    </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content" ng-controller="MasterGroupSetupController" ng-init="LoadMasterGroupDetails()">


                    <div class="page-content-card">
                         
                        <span class="input-icon">
                            <i class="icon icon-account-search s-4 bigger-120"></i>
                            <input type="text" ng-model="searchEmployeeID" placeholder="Search by any field" class="input-small " />


                        </span>

                        <table id="formSummary-table" class="table dataTable">

                            <thead>

                                <tr>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Group Name</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Category</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Section Name</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title"> Custom Value1</span>
                                        </div>
                                    </th> 
                                    

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Custom Value2</span>
                                        </div>
                                    </th>


                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Status</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Effective Date</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Action</span>
                                        </div>
                                    </th>

                                </tr>
                            </thead>

                            <tbody>

                                <tr ng-repeat="MasterGroupModel in masterGroupList | filter : searchEmployeeID" tableload>
                                    <td>
                                        {{MasterGroupModel.groupName}}
                                    </td>
                                    <td>  {{MasterGroupModel.groupSubItemIDString}}</td>


                                    <td>
                                        <p ng-repeat="SECTION in MasterGroupModel.sectionName | commaBreak">{{SECTION}}</p>
                                    </td>
                                    <td>
                                        {{MasterGroupModel.customInteger1}}
                                    </td>
                                    <td>
                                        {{MasterGroupModel.customString1}}
                                    </td>  

                                    <td>
                                        {{MasterGroupModel.statusDesc}}
                                    </td>
                                    <td>
                                        {{MasterGroupModel.effectiveDate}}
                                    </td>
                                    <td>


                                        

                                        <a data-ng-href="@Url.Action("EditMasterGroupSetup", "MasterSetup")/{{MasterGroupModel.groupID}}"> <i class="icon icon-pencil s-4"></i>  </a>


                                        <button type="button" class="btn btn-icon" aria-label="Product details" ng-click="DeleteMasterGroupSetup(MasterGroupModel)">
                                            <i class="icon icon-delete s-4"></i>
                                        </button>

                                    </td>



                                </tr>

                            </tbody>
                        </table> 

                        

                        <!-- / SUB CONTENT -->
                    </div>
                </div>
            <!-- / CONTENT -->
        </div>

        </div>


    </div>

</div>
