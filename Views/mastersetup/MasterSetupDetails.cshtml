@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>

    <script src="~/lib/appJS/MasterSetupVal.js"></script>

}
 
<div class="content-wrapper">

    <div class="content">
        <div class="page-layout simple left-sidebar-inner" ng-app="MasterSetupApp">

            <!-- HEADER -->
            <div class="page-header bg-primary text-auto p-4">

                <div class="d-flex flex-row align-items-center"> 
                    <span class="h3">Component Setup/Details</span> 
                </div>
            </div>
            <!-- / HEADER -->

            <div class="page-content-wrapper"  ng-controller="MasterSetupController" ng-init="LoadMasterSetupDetails('@Html.Raw(ViewBag.Action)')">

                <aside class="page-sidebar" data-fuse-bar="demo-sidebar" data-fuse-bar-media-step="md" >
                    <!-- DEMO CONTENT -->
                    <div class="demo-sidebar">
                         
                        <ul class="nav flex-column custom-scrollbar" id="sidenav" data-children=".nav-item" >

                            <li class="subheader">
                                <span>Master Group</span>
                            </li>



                            <li class="nav-item" role="tab" id="heading-ecommerc1e1" ng-repeat="MasterGroupModel in masterGroupList">

                                <a class="nav-link ripple with-arrow collapsed"
                                   data-toggle="collapse"
                                   data-target="#collapse-ecommerce-{{MasterGroupModel.groupID}}"
                                   href="#"
                                   aria-expanded="false"
                                   aria-controls="collapse-ecommerce-{{MasterGroupModel.groupID}}">
                                    <i class="icon s-4 icon-view-quilt"></i>
                                    <span>{{MasterGroupModel.groupName}}</span>
                                </a>
                                <ul id="collapse-ecommerce-{{MasterGroupModel.groupID}}"
                                    class="collapse"
                                    role="tabpanel"
                                    aria-labelledby="heading-ecommerce-{{MasterGroupModel.groupID}}"
                                    data-children=".nav-item" >

                                    <li class="nav-item" ng-repeat="SECTION in MasterGroupModel.sectionName | commaBreak">
                                        <a class="nav-link ripple " href="/MasterSetup/MasterSetupDetails?id={{SECTION}}">
                                            <span>{{SECTION}}</span>
                                        </a>
                                    </li>
                                       
                                </ul>
                            </li>
                        </ul>
                    </div>
                    <!-- / DEMO CONTENT -->
                </aside>

                <!-- CONTENT -->
                <div class="page-content col-md-10">

                    <div class="demo-content" >
                        <ul class="nav nav-tabs" id="myTab" role="tablist">

                            <li class="nav-item">
                                <a class="nav-link btn active" id="basic-info-tab" data-toggle="tab"
                                   href="#basic-info-tab-pane"
                                   role="tab" aria-controls="basic-info-tab-pane" aria-expanded="true">
                                    General Parameters

                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link btn" id="product-images-tab" data-toggle="tab"
                                   href="#product-images-tab-pane"
                                   role="tab" aria-controls="product-images-tab-pane">Calculation Info</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn" id="tax-tab" data-toggle="tab"
                                   href="#tax-tab-pane"
                                   role="tab" aria-controls="tax-tab-pane">TAX Parameters</a>
                            </li>


                        </ul>

                        <div class="tab-content" >
                            <div class="tab-pane fade show active" id="basic-info-tab-pane" role="tabpanel"
                                 aria-labelledby="basic-info-tab">

                                <div class="card p-6">
                                    <div class="row p-xl-1" ng-If="userDisplayList.GenPropName">
                                        <div class="col-6">
                                            <div class="form-group ">
                                                <label>Name</label>
                                                <input type="text" class="form-control" name="masterGenList" ng-model="masterGenList.genPropName">

                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="form-group">
                                                <label>Description</label>
                                                <input type="text" class="form-control" name="masterGenList" ng-model="masterGenList.genPropDesc">


                                            </div>
                                        </div>
                                    </div>
                                    <div class="row p-xl-1" ng-If="userDisplayList.propType">
                                        <div class="col-4">
                                            <div class="form-group ">
                                                <label> Component Type</label>

                                                 
                                                <select class="form-control col-md-6"  ng-model="masterGenList.propType"   ng-options="CompType.compID as CompType.compName for CompType in compTypeList"></select>




                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <input type="hidden" class="form-control" name="masterGenList" ng-model="masterGenList.masterSectionID">
                                        </div>
                                    </div>




                                    <div class="row p-xl-1 div-border bg-grey-300" ng-If="userDisplayList.optionalTextDisplay">

                                        <div class="col-12">
                                            Optional Selection Items
                                        </div>

                                    </div>
                                    <div class="row p-xl-1" ng-If="userDisplayList.isOverridden">
                                        <div class="col-6">
                                            <div class="col-md-12">
                                                <input type="checkbox" name="masterGenList" ng-model="masterGenList.isOverridden" class="defaultCheckBox"> Override this component manually
                                            </div>

                                        </div>

                                        <div class="col-6">   </div>
                                    </div>
                                    <div class="row p-xl-1" ng-If="userDisplayList.isVisibleUI">
                                        <div class="col-6">
                                            <div class="col-md-12">
                                                <input type="checkbox" name="masterGenList" ng-model="masterGenList.isVisibleUI" class="defaultCheckBox"> Show this Component for users
                                            </div>

                                        </div>

                                        <div class="col-6">  </div>
                                    </div>

                                    <div class="row p-xl-1" ng-If="userDisplayList.isNonProratedItem">
                                        <div class="col-6">
                                            <div class="col-md-12">
                                                <input type="checkbox" name="masterGenList" ng-model="masterGenList.isNonProratedItem" class="defaultCheckBox"> Non Prorate component
                                            </div>

                                        </div>

                                        <div class="col-6">  </div>
                                    </div>

                                    <div class="row p-xl-1" ng-If="userDisplayList.isCarryForward">
                                        <div class="col-6">
                                            <div class="col-md-12">
                                                <input type="checkbox" name="masterGenList" ng-model="masterGenList.isCarryForward" class="defaultCheckBox"> Carry forword data to next month
                                            </div>

                                        </div>

                                        <div class="col-6">  </div>
                                    </div>

                                    <div class="row p-xl-1" ng-If="userDisplayList.isOTPayment">
                                        <div class="col-6">
                                            <div class="col-md-12">
                                                <input type="checkbox" name="masterGenList" ng-model="masterGenList.isOTPayment" class="defaultCheckBox"> One time payment allowed
                                            </div>

                                        </div>

                                        <div class="col-6">  </div>
                                    </div>
                                    <div class="row p-xl-1" ng-If="userDisplayList.isReimburse">
                                        <div class="col-6">
                                            <div class="col-md-12">
                                                <input type="checkbox" name="masterGenList" ng-model="masterGenList.isReimburse" class="defaultCheckBox"> Reimbursement allowed
                                            </div>

                                        </div>

                                        <div class="col-6">  </div>
                                    </div>


                                </div>
                            </div>
                            <div class="tab-pane fade" id="product-images-tab-pane" role="tabpanel"
                                 aria-labelledby="product-images-tab">

                                <div class="card p-6">

                                    <div class="input-group mb-8" ng-If="userDisplayList.agentType">

                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>Agent Type</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.agentType"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>


                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>
                                    <div class="input-group mb-8" ng-If="userDisplayList.formula">

                                        <div class="col-5">
                                            <div class="form-group ">

                                                <label>Formula</label>
                                                <input type="text" class="form-control col-md-6" name="masterAgentList" ng-model="masterAgentList.formula">

                                            </div>
                                        </div>
                                        <div class="col-2">
                                            % of
                                        </div>
                                        <div class="col-5">
                                            <div class="form-group "> 
                                                <input type="text" class="form-control col-md-6" name="masterAgentList" ng-model="masterAgentList.formulaField">
                                                <input type="hidden" class="form-control col-md-6" name="masterAgentList" ng-model="masterAgentList.masterSectionID">
                                            </div>
                                        </div>

                                    </div>

                                    <div class="input-group mb-8" ng-If="userDisplayList.optionsID">
                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>OptionsID</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.optionsID"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>

                                    <div class="input-group mb-8" ng-If="userDisplayList.loanPerquisteID">

                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>LoanPerquisteID</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.loanPerquisteID"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>
                                    <div class="input-group mb-8" ng-If="userDisplayList.arrearCalc">

                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>Select Arrear Calculation Field</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.arrearCalc"
                                                        ng-options="UserConfig.paramID as UserConfig.paramValue for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>
                                    <div class="input-group mb-8" ng-If="userDisplayList.ArrearPayItem">

                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>ArrearPayItem</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.arrearPayItem"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>
                                    <div class="input-group mb-8" ng-If="userDisplayList.reversalMainItem">
                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>ReversalMainItem</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.reversalMainItem"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>
                                    <div class="input-group mb-8" ng-If="userDisplayList.reversalLOPItem">

                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>ReversalLOPItem</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.reversalLOPItem"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>
                                    <div class="input-group mb-8" ng-If="userDisplayList.reversalLOP">

                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>ReversalLOP</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.reversalLOP"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>


                                    <div class="input-group mb-8" ng-If="userDisplayList.reversalLOPWDay">

                                        <div class="col-6">
                                            <div class="form-group ">

                                                <label>ReversalLOPWDay</label>
                                                <select class="form-control col-md-6" ng-model="masterAgentList.reversalLOPWDay"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-6">

                                        </div>

                                    </div>



                                    <div class="row p-xl-1 div-border bg-grey-300">

                                        <div class="col-12">
                                            Optional Selection Items
                                        </div>

                                    </div>
                                    <div class="row p-xl-1" ng-If="userDisplayList.roundupType">
                                        <div class="col-6">
                                            <div class="col-md-12">

                                                <input type="checkbox" name="masterAgentList" ng-model="masterAgentList.roundupType" class="defaultCheckBox">  RoundupType

                                            </div>

                                        </div>

                                        <div class="col-6">

                                        </div>
                                    </div>
                                    <div class="row p-xl-1" ng-If="userDisplayList.contribution">
                                        <div class="col-6">
                                            <div class="col-md-12">

                                                <input type="checkbox" name="masterAgentList" ng-model="masterAgentList.contribution" class="defaultCheckBox">  Contribution

                                            </div>

                                        </div>

                                        <div class="col-6">

                                        </div>
                                    </div>
                                    <div class="row p-xl-1" ng-If="userDisplayList.enableMidMonthProcess">
                                        <div class="col-6">
                                            <div class="col-md-12">

                                                <input type="checkbox" name="masterAgentList" ng-model="masterAgentList.enableMidMonthProcess" class="defaultCheckBox"> Enable Mid Month Process

                                            </div>

                                        </div>

                                        <div class="col-6">

                                        </div>
                                    </div>

                                    <div class="row p-xl-1" ng-If="userDisplayList.stopCarryForward">
                                        <div class="col-6">
                                            <div class="col-md-12">

                                                <input type="checkbox" name="masterAgentList" ng-model="masterAgentList.stopCarryForward" class="defaultCheckBox"> StopCarryForward

                                            </div>

                                        </div>

                                        <div class="col-6">

                                        </div>
                                    </div>

                                    <div class="row p-xl-1" ng-If="userDisplayList.prorateGrossWDays">
                                        <div class="col-6">
                                            <div class="col-md-12">


                                                <input type="checkbox" name="masterAgentList" ng-model="masterAgentList.prorateGrossWDays" class="defaultCheckBox"> ProrateGrossWDays

                                            </div>

                                        </div>

                                        <div class="col-6">

                                        </div>
                                    </div>

                                    <div class="row p-xl-1" ng-If="userDisplayList.prorateLOPWDays">
                                        <div class="col-6">
                                            <div class="col-md-12">

                                                <input type="checkbox" name="masterAgentList" ng-model="masterAgentList.prorateLOPWDays" class="defaultCheckBox"> ProrateLOPWDays

                                            </div>

                                        </div>

                                        <div class="col-6">

                                        </div>
                                    </div>



                                </div>

                            </div>
                            <div class="tab-pane fade" id="tax-tab-pane" role="tabpanel"
                                 aria-labelledby="tax-tab">

                                <div class="card p-6">

                                    <div class="input-group mb-8" ng-If="userDisplayList.taxItemType">

                                        <div class="col-5">
                                            <div class="form-group ">


                                                <label>Tax Item</label>
                                                <select class="form-control col-md-6" ng-model="masterTaxList.taxItemType"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList| filter:{paramType:'TAX_ITEM'}">
                                                    <option value="-1">Select Task type1</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-7">
                                            <div class="form-group">

                                            </div>
                                        </div>

                                    </div>

                                    <div class="input-group mb-8" ng-If="userDisplayList.taxSectionID">

                                        <div class="col-5">
                                            <div class="form-group ">


                                                <label>Tax Section</label>
                                                <select class="form-control col-md-6" ng-model="masterTaxList.taxSectionID"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList| filter:{paramType:'TAX_SECTION'}">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-7">
                                            <div class="form-group">

                                            </div>
                                        </div>

                                    </div>
                                    <div class="input-group mb-8" ng-If="userDisplayList.exemptionID">

                                        <div class="col-5">
                                            <div class="form-group ">


                                                <label>Exemption ID</label>
                                                <select class="form-control col-md-6" ng-model="masterTaxList.exemptionID"
                                                        ng-options="UserConfig.paramID as UserConfig.paramName for UserConfig in userConfigList| filter:{paramType:'TAX_EXEMPTION_ITEM'}">
                                                    <option value="-1">Select Task type</option>
                                                </select>

                                            </div>
                                        </div>
                                        <div class="col-7">
                                            <div class="form-group">

                                            </div>
                                        </div>

                                    </div>

                                </div>

                            </div>
                            <div class="row">


                                <div class="col-lg-2" ng-if="masterGenList != 'null'">
                                    <div class="payment-adress">
                                        <button type="submit" class="btn btn-primary waves-effect waves-light" ng-click="SaveMasterSetup(masterGenList,masterAgentList, masterTaxList)">Submit</button>
                                    </div>
                                </div>
                                <div class="col-lg-9">
                                </div>
                            </div>



                        </div>
                        <!-- / CONTENT -->

                    </div>

                    </div>
                </div>
            </div>

        </div>
</div>