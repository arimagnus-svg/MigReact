@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>


    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
    <script src="~/lib/appJS/SelfServiceSetup.js"></script>


}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="SelfService" ng-controller="SelfServiceController">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Add Bank & PF details </div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">


                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="tab-content">




                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">


                                <!-- USING THE GRID COMPLEX -->
                                <div class="col-12">
                                    <div class="example">
                                        <div class="description">
                                            <div class="description-text">
                                                <div class="row no-gutters align-items-center justify-content-between">




                                                </div>
                                            </div>
                                            <div class="toggle-source-preview">

                                            </div>
                                        </div>
                                        <div class="source-preview-wrapper">
                                            <div class="preview">
                                                <div class="preview-elements">
                                                    <div class="container">
                                                        <form>
                                                            <div class="row">

                                                                <div class="form-group col-md-8">
                                                                    <div class="row p-xl-1" ng-if="msg!=''">

                                                                        <div class="preview">
                                                                            <div class="preview-elements">
                                                                                <div class="alert alert-warning alert-dismissible fade show"
                                                                                     role="alert">
                                                                                    <button type="button" class="close" data-dismiss="alert"
                                                                                            aria-label="Close">
                                                                                        <span aria-hidden="true">&times;</span>
                                                                                    </button>
                                                                                    <strong>{{msg}}</strong>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>


                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>
                                                            </div>

                                                            <div class="row">

                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Bank Name</label>


                                                                    <input type="text" class="form-control" name="EmpSalPFModel.BankName" ng-model="EmpSalPFModel.bankName">

                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Bank Account</label>


                                                                    <input type="text" class="form-control" name="EmpSalPFModel.BankAccountNo" ng-model="EmpSalPFModel.bankAccountNo">

                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">PF AccountNo</label>


                                                                    <input type="text" class="form-control" name="EmpSalPFModel.PFAccountNo" ng-model="EmpSalPFModel.pfAccountNo">

                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">PAN No</label>


                                                                    <input type="text" class="form-control" name="EmpSalPFModel.PANAccountNo" ng-model="EmpSalPFModel.panAccountNo">

                                                                </div>
                                                            </div>




                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="SaveBankPF(EmpSalPFModel)">
                                                                        Save
                                                                    </button>

                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>

                                                            </div>

                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <!-- USING THE GRID COMPLEX -->


                            </div>


                            <!-- / SUB CONTENT -->



                        </div>

                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>
