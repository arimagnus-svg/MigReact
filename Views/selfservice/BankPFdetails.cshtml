@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/angular-route.js"></script>

    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>


    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
    <script src="~/lib/appJS/SelfServiceSetup.js"></script>


}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="SelfService" ng-controller="SelfServiceController" ng-init="LoadBankPFDetails()">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Bank and PF Details</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-auto">
                        <a href="/SelfService/AddBankPF" class="btn btn-secondary">Add Bank/PF</a>

                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="page-content-card">
                        
                           

                                <!-- CONTACT LIST HEADER -->
                        <table id="formSummary-table" class="table dataTable">

                            <thead>

                                <tr>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employe ID</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title"> PF Account No</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Bank Name</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Bank Account No</span>
                                        </div>
                                    </th>


                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">PAN Number</span>
                                        </div>
                                    </th>  

                                   
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Status</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Action</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr ng-repeat="EmpSalPFModel in modelList" tableload>
                                    <td>
                                        {{EmpSalPFModel.employeeID}}
                                    </td>
                                    <td> {{EmpSalPFModel.pfAccountNo}}</td> 

                                    <td>
                                        {{EmpSalPFModel.bankName}}
                                    </td>
                                            

                                    <td>
                                        {{EmpSalPFModel.bankAccountNo}}
                                    </td>
                                    <td>
                                        {{EmpSalPFModel.panAccountNo}}
                                    </td>

                                    <td>

                                        <span class="badge badge-info" ng-if="EmpSalPFModel.status===1"> Submitted</span>
                                        <span class="badge badge-info" ng-if="EmpSalPFModel.status===2"> Updated</span>

                                        <span class="badge badge-warning" ng-if="EmpSalPFModel.status===3"> Deleted</span>

                                        <span class="badge badge-success" ng-if="EmpSalPFModel.status===4"> Approved</span>
                                    </td>
                                    <td>


                                        <a href="EditBankPF??EmpPID={{EmpSalPFModel.empPID}}">
                                            <i class="icon icon-pencil s-4"></i>
                                        </a>

                                        
                                    </td>



                                </tr>

                            </tbody>
                        </table> 
                               

                                <!-- CONTACT ITEM -->

                                <div class="col-12 form-check has-danger" ng-if="modelList.length<=0">

                                    <br />
                                    <label class="form-check-label"><span>Bank details not found</span></label>
                                </div>




 

 
                            <!-- / SUB CONTENT -->



 

                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>