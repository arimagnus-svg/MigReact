                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-2">
                                                                                                <div class="form-group ">
                                                                                                    <input type="text" class="form-control" name="InsuranceCompany" ng-model="TaxProofModel.companyName">

                                                                                                </div>

                                                                                            </div>
                                                                                            <div class="col-1">
                                                                                                <div class="form-group ">
                                                                                                    <input type="text" class="form-control" name="PaymentDate" ng-model="TaxProofModel.paymentDate">

                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-1">
                                                                                                <div class="form-group ">
