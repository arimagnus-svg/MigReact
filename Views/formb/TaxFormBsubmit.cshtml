                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-2">

                                                                                                <div class="form-group ">

                                                                                                    <input type="file" id="file" ngf-select ng-model="fileModelList.fileItem" ngf-pattern="'*'"
                                                                                                           ngf-change="clearImageErrorMsgs()" />
                                                                                                </div>
                                                                                            </div>
                                                                                            <div class="col-2">
                                                                                                <div class="form-group " ng-if="TaxProofModel.paymentAmount!=0">
                                                                                                    <button type="submit" class="btn btn-primary waves-effect waves-light" ng-click="uploadFile(TaxProofModel,'HouseProperty')">Update</button>


                                                                                                </div>
                                                                                                <div class="form-group " ng-if="TaxProofModel.paymentAmount==0">
                                                                                                    <button type="submit" class="btn btn-primary waves-effect waves-light" ng-click="uploadFile(TaxProofModel,'HouseProperty')">Upload</button>


                                                                                                </div>
                                                                                            </div>

                                                                                        </div>
                                                                                        <div class="row p-xl-1">
                                                                                            <div class="col-12 bg-blue-100">
                                                                                                <label>Uploaded Files:</label>

                                                                                            </div>
                                                                                            <div class="col-12">

                                                                                                <div class="col-3" ng-repeat="TaxDocModel in taxDocList| filter:'HouseProperty'">

                                                                                                    <div>
                                                                                                        {{TaxDocModel.filename}}
                                                                                                        <button type="submit" class="btn btn-icon btn-sm" ng-click="downlaodFile(TaxDocModel)"> <i class="icon icon-download"></i></button>
                                                                                                        <button type="submit" class="btn btn-icon btn-sm" ng-click="DeleteFile(TaxDocModel)">  <i class="icon-delete"></i></button>


                                                                                                    </div>

                                                                                                </div>
                                                                                            </div>



                                                                                        </div>


                                                                                    </div> <!-- card block-->

                                                                                </div>
                                                                            </div>

                                                                        </div>
                                                                    </div>

                                                                </div>

                                                            </div> <!-- card block-->
                                                        </div> <!-- collapse-->
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- source-preview-wrapper end here-->
                                </div>
                            </div>
                        </div>

                    </div>


                    <div class="row">
                        <div class="col-lg-1" ng-if="formBList != 'null' && formBList.FormID!=0">
                            <div class="payment-adress">
                                <button type="submit" class="btn btn-primary waves-effect waves-light" ng-click="UpdateFormB(formBList,HousePropertyList,formBRentList,TaxSec80List,TaxSecVIAOtherList)">Update</button>
                            </div>
                        </div>

                        <div class="col-lg-2" ng-if="formBList.FormID==0">
                            <div class="payment-adress">
                                <button type="submit" class="btn btn-primary waves-effect waves-light" ng-click="SaveFormB(formBList,HousePropertyList,formBRentList,TaxSec80List,TaxSecVIAOtherList)">Save</button>
                            </div>
                        </div>
                        <div class="col-lg-9">
                        </div>
                    </div>


                </div>
            </div>
            <!-- / CONTENT -->
        </div>

    </div>

</div>
