@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>
    <script type="text/javascript" src="~/lib/js/FileSaver.js"></script>

    <script src="~/lib/appJS/FormBVal.js"></script>




}



<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-orders" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="TaxBApp" ng-controller="TaxBController" ng-init="LoadFormBSubmitSummaryReport()">

                <!-- HEADER -->
                <div class="header  bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-12 col-sm">

                        <div class="logo row no-gutters align-items-start">

                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cards-variant s-6"></i>
                            </div>

                            <div class="logo-text">
                                <div class="h4">Form B-Investment status  report</div>
                                <div class=""></div>
                            </div>

                        </div>
                    </div>
                    <!-- / APP TITLE -->
                    <!-- SEARCH -->
                    <div class="col search-wrapper pl-2">

                        <div class="input-group">

                            <div class="logo-icon mr-3 mt-1"><label>Select Year</label></div>

                            <div class="logo-text">
                                <select class="form-control col-md-12" ng-model="Years" ng-change="LoadFormBSubmitSummaryReport(Years)">
                                    <option value="">select the Fin Year</option>
                                    <option ng-repeat="L in Years" value="{{L}}">
                                        {{L}}
                                    </option>
                                </select>
                            </div>


                        </div>
                    </div>
                    <!-- / SEARCH -->
                </div>
                <!-- / HEADER -->

                <div class="page-content-card">

                    <table id="formSummary-table" class="table dataTable">

                        <thead>

                            <tr>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">EmployeeID</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">FinYear</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Rent Paid</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Total Income Loss</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">SUM 80C</span>
                                    </div>
                                </th>

                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Medical Insurance</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Declared Status</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">
                                        <span class="column-title">Approved Status</span>
                                    </div>
                                </th>
                                <th>
                                    <div class="table-header">

                                        <span class="column-title">Actions</span>
                                    </div>
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            <tr ng-repeat="FormBSummaryModel in formBSummaryList" tableload>
                                <td>{{FormBSummaryModel.employeeID}}</td>
                                <td>{{FormBSummaryModel.finYear}}</td>
                                <td>{{FormBSummaryModel.rentPaid}}</td>
                                <td>{{FormBSummaryModel.total_IncomeLoss}}</td>
                                <td>
                                    <span class="badge badge-info">{{FormBSummaryModel.suM_80C}}</span>
                                </td>
                                <td class="date">{{FormBSummaryModel.approvedAmount}} </td>
                                <td class="date" ng-if="FormBSummaryModel.declaredStatus==1">
                                    <span class="badge badge-success"> Declared</span>
                                </td>
                                <td class="date" ng-if="FormBSummaryModel.declaredStatus!=1">
                                    <span class="badge badge-warning"> Not Declared</span>
                                </td>
                                <td class="date" ng-if="FormBSummaryModel.approvedStatus==4">
                                    <span class="badge badge-success"> Approved</span>
                                </td>
                                <td class="date" ng-if="FormBSummaryModel.approvedStatus!=4">
                                    <span class="badge badge-info"> Not Approved</span>
                                </td>
                                <td>
                                    <a href="TaxFormBsubmitRepDetails?emp={{FormBSummaryModel.employeeID}}&&year={{FormBSummaryModel.finYear}}">
                                        <i class="icon icon-dots-horizontal s-4"></i>
                                    </a>
                                </td>
                            </tr>


                        </tbody>
                    </table>

                    <div>
                        &nbsp;  <button class="btn-warning" ng-click="DownloadExcel(formBSummaryList,'Form_B_Investment')"><i class="icon icon-download s-4"></i>Export to Excel</button>


                    </div>

                </div>
            </div>
            <!-- / CONTENT -->
        </div>

    </div>
</div>