@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/AppSettingsVal.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
      

}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="AppSettingsApp" ng-controller="AppSettingsController" ng-init="LoadAppSettings()">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon s-4 icon-settings s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Application Settings</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">


                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="tab-content">




                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">


                                <!-- USING THE GRID COMPLEX -->
                                <div class="col-12">
                                    <div class="example">
                                        <div class="description">
                                            <div class="description-text">
                                                <div class="row no-gutters align-items-center justify-content-between">

                                                    <div class="list-title text-muted">

                                                        <div class="row p-xl-1" ng-if="msg!=''">

                                                            <div class="preview">
                                                                <div class="preview-elements">
                                                                    <div class="alert alert-warning alert-dismissible fade show"
                                                                         role="alert">
                                                                        <button type="button" class="close" data-dismiss="alert"
                                                                                aria-label="Close">
                                                                            <span aria-hidden="true">&times;</span>
                                                                        </button>
                                                                        <strong>{{msg}}</strong>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>


                                                </div>
                                            </div>
                                            <div class="toggle-source-preview">
                                                
                                            </div>
                                        </div>
                                        <div class="source-preview-wrapper">
                                            <div class="preview">
                                                <div class="preview-elements">
                                                    <div class="container">
                                                        <form>


                                                            <div class="row">

                                                                <div class="form-group col-md-6">

                                                                    <div class="row">

                                                                        <div class="form-group col-md-6">
                                                                            <label class="col-form-label">Generate Payroll based on</label>

                                                                            <input class="col-form-label" type="radio"
                                                                                   name="payrollGenOptions"
                                                                                   ng-model="AppSettingsModel.payrollGenOptions"
                                                                                   value="Attendence" ng-checked="AppSettingsModel.payrollGenOptions!='Timesheet'" /> Attendence
                                                                            &nbsp;  &nbsp;
                                                                            <input class="col-form-label" type="radio"
                                                                                   name="payrollGenOptions"
                                                                                   ng-model="AppSettingsModel.payrollGenOptions"
                                                                                   value="Timesheet" ng-checked="AppSettingsModel.payrollGenOptions=='Timesheet'" /> Timesheet
                                                                        </div>

                                                                        <div class="form-group col-md-6">
                                                                            <label class="col-form-label">TaxRegime Default Options</label>

                                                                            <input class="col-form-label"  type="radio"
                                                                                   name="taxRegimeDefaultOptions"
                                                                                   ng-model="AppSettingsModel.taxRegimeDefaultOptions"
                                                                                   value="Old_Regime" ng-checked="AppSettingsModel.taxRegimeDefaultOptions!='New_Regime'" /> Old_Regime
                                                                            &nbsp;  &nbsp;
                                                                            <input class="col-form-label" type="radio"
                                                                                   name="taxRegimeDefaultOptions"
                                                                                   ng-model="AppSettingsModel.taxRegimeDefaultOptions"
                                                                                   value="New_Regime" ng-checked="AppSettingsModel.taxRegimeDefaultOptions=='New_Regime'" /> New_Regime

                                                                  
                                                                        </div>


                                                                    </div>
                                                                         

                                                                </div>
                                                                <div class="form-group col-md-6">
                                                                   
                                                                    <div class="row">

                                                                        <div class="form-group col-md-8">
                                                                            <label class="col-form-label">Working Days</label>

                                                                            <input class="col-form-label" type="radio"
                                                                                   name="defaultWorkingDays"
                                                                                   ng-model="AppSettingsModel.defaultWorkingDays"
                                                                                   value="5D" ng-checked="AppSettingsModel.defaultWorkingDays!='Timesheet'" /> 5 Days (Mon-Fri)
                                                                            &nbsp;  &nbsp;
                                                                            <input class="col-form-label" type="radio"
                                                                                   name="defaultWorkingDays"
                                                                                   ng-model="AppSettingsModel.defaultWorkingDays"
                                                                                   value="6D" ng-checked="AppSettingsModel.defaultWorkingDays=='Timesheet'" /> 6 Days (Mon-Sat)
                                                                        </div>

                                                                        <div class="form-group col-md-4">
                                                                            
                                                                        </div>


                                                                    </div>


                                                                  
                                                                </div>
                                                            </div>

                                                            <div class="row"> 


                                                                <div class="form-group col-md-6">
