@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/SettlementVal.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
      

}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="SettlementApp" ng-controller="SettlementController" ng-init="LoadSettlement()">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Final Settlement Processing</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-auto">
                        <a href="/Settlement/AddSettlement" class="btn btn-secondary">Add Settlement</a>

                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="page-content-card">
                        


                        <span class="input-icon">
                            <i class="icon icon-account-search s-4 bigger-120"></i>
                            <input type="text" ng-model="searchEmployeeID" placeholder="Search by any field" class="input-small " />


                        </span>

                        <table id="formSummary-table" class="table dataTable">

                            <thead>

                                <tr>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employee ID</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employee Name</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Resignation Date</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">LWD</span>
                                        </div>
                                    </th>  

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Settlement Date</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Days Served</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title"># Leave Encashed</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Status</span>
                                        </div>
                                    </th>
                                    
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Action</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr ng-repeat="SettlementModel in settlementList | filter : searchEmployeeID" tableload>
                                    <td>
                                        {{SettlementModel.employeeID}}
                                    </td>
                                    <td> {{SettlementModel.empName}}</td>

                                    <td> {{SettlementModel.resignationDate}}</td>
                                    <td> {{SettlementModel.lwd}}</td>
                                    <td> {{SettlementModel.settlementDate}}</td>
                                    <td> {{SettlementModel.daysServed}}</td>
                                    <td>  {{SettlementModel.totalLeaveEncash}} </td>  

                                    <td>
                                        {{SettlementModel.statusDesc}}
                                    </td>
                                     
 

                                    <td>
                                        <a href="EditSettlement/?FinalSettlementID={{SettlementModel.finalSettlementID}}">
                                            <i class="icon icon-pencil s-4"></i>
                                        </a>
                                        &nbsp;
                                        <button type="button" class="btn btn-secondary" ng-click="ProcessSettlement(SettlementModel)">
                                            <i class="icon s-4 icon-check"></i>  Process
                                        </button> 



                                    </td>

                                </tr>

                            </tbody>
                        </table> 

                            <!-- / SUB CONTENT -->

                            <div ng-if="settlementList.length<1" class="card p-6">
                                NO Settlement pending for current month.
                            </div>

                        

                    </div>

                   


                </div>
                <!-- / CONTENT -->

               

            </div>

        </div>


    </div>
</div>