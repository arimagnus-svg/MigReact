@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/ProfileSalaryValChange.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
    <link rel="stylesheet" type="text/css" href="~/css/simple.css" />

}

<div class="content-wrapper">

    <div class="content" ng-app="ProfileSalaryApp">
        <div class="source-preview-wrapper">
            <div class="preview">
                <div class="preview-elements">

                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Auth/Home">Home</a></li>
                        <li class="breadcrumb-item"><a href="/ProfileSalary/ProfileSalaryDetails">Salary Setup Summary </a></li>
                    </ol>
                </div>
            </div>
        </div>
        <div id="e-commerce-product" class="page-layout simple tabbed" ng-controller="ProfileSalaryController" ng-init="LoadAddProfileSalary()">

            <!-- HEADER -->
            <div class="page-header bg-primary text-auto row no-gutters align-items-center justify-content-between p-2">


                <div class="row">

                    <div class="form-group col-3">
                        <label>Search by Employee ID</label>
                    </div>
                    <div class="form-group col-3">

                        <input type="text" ng-model="searchID" />

                    </div>
                    <div class="form-group col-2">
                        

                    </div>
                    <div class="form-group col-3" ng-if="searchID!=0">

                        Name: <label ng-repeat="EmployeeModel in employeeList| filter:{employeeID:searchID}" ng-if="searchID!=0">{{EmployeeModel.employeeName}}</label>

                        <input type="hidden" name="EmployeeModel" ng-model="EmployeeModel.employeeID">


                    </div>
                </div>

                <div class="row">

                    <div class="form-group col-6">
                        <label></label>

                    </div>
                    <div class="form-group col-3">
                       

                    </div>

                </div>



            </div>
            <!-- / HEADER -->
            <!-- CONTENT -->
            <div class="page-content" >

                <ul class="nav nav-tabs" id="myTab" role="tablist">

                    <li class="nav-item">
                        <a class="nav-link btn active" id="basic-info-tab" data-toggle="tab"
                           href="#basic-info-tab-pane"
                           role="tab" aria-controls="basic-info-tab-pane" aria-expanded="true">
                            Salary Component
                        </a>
                    </li>

                    


                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="basic-info-tab-pane" role="tabpanel"
                         aria-labelledby="basic-info-tab">

                        <div class="card p-6">
                            <div class="row p-xl-1 div-border bg-grey">

                                <div class="col-6">
                                    Salary Component


                                </div>
                                <div class="col-3">

                                </div>
                                <div class="col-3">

                                </div>
                            </div>
                            <div class="row p-xl-1 div-border">
                                <div class="col-4">
                                    Financial Year
                                </div>
                                <div class="col-2">
                                    <input type="text" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.year" class="defaultTextBox">
                                </div>
                                <div class="col-4">

                                   Effective Date
                                </div>
                                <div class="col-2">

                                    <input type="date" class="defaultTextBox"   name="ProfileSalaryModel.effectiveDate" ng-model="ProfileSalaryModel.effectiveDate">
                                </div>
                            </div>
                            <div class="row p-xl-1 div-border">
                                <div class="col-4">
                                    CTC
                                </div>
                                <div class="col-2">
                                    <input type="number" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.ctc" class="defaultTextBox">
                                </div>
                                <div class="col-6">
                                  
                                    <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.salaryProfileID" readonly>

                                </div>
                            </div>
                            <div class="row p-xl-1 div-border">
                                <div class="col-4">
                                    VariablePay
                                </div>
                                <div class="col-2">
                                    <input type="number" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.variablePay" class="defaultTextBox">
                                </div>
                                <div class="col-6">
                                   

                                </div>
                            </div>
                            <div class="row p-xl-1 div-border">
                                <div class="col-4">
                                    Others
                                </div>
                                <div class="col-2">
                                    <input type="number" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.others" class="defaultTextBox">
                                </div>
                                <div class="col-6">
                                  

                                </div>
                            </div>
                            <div class="row p-xl-1 div-border bg-grey-300">
                                <div class="col-12">
                                    Select Salary group/component
                                </div>

                            </div>
                            <div class="row p-xl-1 div-border">
                                <div class="simpleDemo row">

                                    <div class="col-md-12">
                                        <div class="row">

                                            <div ng-repeat="(listName, list) in models.lists" class="col-md-6">
                                                <div class="panel panel-info">
                                                    <div class="panel-heading">
                                                        <h6 class="panel-title"> {{listName}}</h6>
                                                    </div>
                                                    <div class="panel-body">

                                                        <ul dnd-list="list">

                                                            <li ng-repeat="item in list"
                                                                dnd-draggable="item"
                                                                dnd-moved="list.splice($index, 1)"
                                                                dnd-effect-allowed="move"
                                                                dnd-selected="models.selected = item"
                                                                ng-class="{'selected': models.selected === item}">
                                                                {{item.label}}
                                                            </li>
                                                        </ul>




                                                    </div>
                                                </div>
                                            </div>
                                        </div>



                                    </div>

                                </div>

                            </div>



                            <div class="row p-xl-1 div-border bg-grey-300" ng-if="ProfileSalaryModel.isSalaryInfoPresent==true">


                                <div class="col-6">
                                    Salary Breakup Details


                                </div>
                                <div class="col-3">
                                    System Value
                                </div>
                                <div class="col-3">
                                    Custom Value
                                </div>

                                <!-- GROUP Details -->

                                <div class="col-12" ng-repeat="ProfileSalaryComponentDic in profileSalaryComponentList">
                                    <div class="source-preview-wrapper" ng-repeat="(key, ProfileSalaryComponentModelList) in ProfileSalaryComponentDic">
                                        <!-- ng-repeat="HousePropertyModel in HousePropertyList"-->
                                        <div class="preview">
                                            <div class="preview-elements">
                                                <div id="accordion" role="tablist">
                                                    <div class="card">
                                                        <a data-toggle="collapse" href="#collapseHouse{{key}}"
                                                           aria-expanded="true"
                                                           aria-controls="collapseOne">
                                                            <div class="card-header" role="tab" id="headingOne">
                                                                <div class="col-6">{{key}}</div>
                                                                <div class="col-3"></div>
                                                                <div class="col-3">

                                                                </div>
                                                            </div>
                                                        </a>
                                                        <div id="collapseHouse{{key}}" class="collapse" role="tabpanel"
                                                             aria-labelledby="headingOne"
                                                             data-parent="#accordion">
                                                            <div class="card-block">


                                                                <div class="row p-xl-1 div-border" ng-repeat="ProfileSalaryComponentModel in ProfileSalaryComponentModelList">
                                                                    <div class="col-5">
                                                                        {{ProfileSalaryComponentModel.sectionName}}
                                                                        <input type="hidden" name="formBList" ng-model="ProfileSalaryComponentModel.sectionName" readonly>
                                                                        <input type="hidden" name="formBList" ng-model="ProfileSalaryComponentModel.sectionID" readonly>

                                                                    </div>
                                                                    <div class="col-1">
                                                                    </div>
                                                                    <div class="col-3">
                                                                        <input type="text" name="ProfileSalaryComponentModel" ng-model="ProfileSalaryComponentModel.currentValue" class="defaultTextBox">
                                                                        <input type="hidden" name="formBList" ng-model="ProfileSalaryComponentModel.profileEmpSalaryDrillID" readonly>
                                                                        <input type="hidden" name="formBList" ng-model="ProfileSalaryComponentModel.salaryProfileID" readonly>
                                                                    </div>

                                                                    <div class="col-3">
                                                                        <input type="text" name="ProfileSalaryComponentModel" ng-model="ProfileSalaryComponentModel.userOverrideValue" class="defaultTextBox">
                                                                        <input type="hidden" name="formBList" ng-model="ProfileSalaryComponentModel.employeeID" readonly>
                                                                        <input type="hidden" name="formBList" ng-model="ProfileSalaryComponentModel.masterGroup" readonly>
                                                                    </div>
                                                                </div>



                                                            </div> <!-- card block-->
                                                        </div> <!-- collapse-->
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <!-- GROUP Details end -->
                                <div class="col-12">
                                    <div> ***  Income Tax, Professional Tax and Other Deduction are calcualted durng monthly Salary generation process...</div>
                                 </div>


                            </div>


                        </div>
                    </div>
                    <div class="tab-pane fade" id="product-images-tab-pane" role="tabpanel"
                         aria-labelledby="product-images-tab">



                    </div>

                    <div class="row" ng-if="ProfileSalaryModel.isSalaryInfoPresent==false">
                        <div class="col-lg-1">
                            <div class="payment-adress">

                                <button type="button" class="btn btn-primary waves-effect waves-light" aria-label="Product details" ng-click="CalculateSalary(ProfileSalaryModel, models,searchID)">
                                    Salary Break
                                </button>

                            </div>
                        </div>
                        <div class="col-lg-9">
                        </div>
                    </div>

                    <div class="row" ng-if="ProfileSalaryModel.isSalaryInfoPresent==true">
                        <div class="col-lg-1">
                            <div class="payment-adress">

                                <button type="button" class="btn btn-primary waves-effect waves-light" aria-label="Product details" ng-click="SaveSalary(ProfileSalaryModel , ProfileSalaryComponentModelList , ProfileSalaryComponentModel)">
                                   Save Salary Details
                                </button>

                            </div>
                        </div>
                        <div class="col-lg-9">
                        </div>
                    </div>

                </div>
            </div>
            <!-- / CONTENT -->
        </div>

    </div>

</div>