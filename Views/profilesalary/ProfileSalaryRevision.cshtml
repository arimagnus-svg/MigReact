@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>
 
    <script src="~/lib/appJS/ProfileSalaryVal.js"></script>



}



<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="ProfileSalaryApp">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-12 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Profile Salary Revision</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-auto">
                     </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content" ng-controller="ProfileSalaryController" ng-init="LoadProfileSalaryDetails()">


                    <div class="row">

                        <div class="form-group col-md-8">
                            <div class="row p-xl-1" ng-if="msg!=''">

                                <div class="preview">
                                    <div class="preview-elements">
                                        <div class="alert alert-warning alert-dismissible fade show"
                                             role="alert">
                                            <button type="button" class="close" data-dismiss="alert"
                                                    aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <strong>{{msg}}</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                        <div class="form-group col-md-4">

                        </div>
                    </div>


                    <div class="page-content-card">
                            <span class="input-icon">
                                <i class="icon icon-account-search s-4 bigger-120"></i>
                                <input type="text" ng-model="searchEmployeeID" placeholder="Search by any field" class="input-small " />


                            </span>

                        <table id="formSummary-table" class="table dataTable">

                            <thead>

                                <tr>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employee ID [Name]</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Year</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Current Total Salary</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Last year Revision %</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Revision %</span>
                                        </div>
                                    </th>   
                                    

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Revised Total Salary</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Revision Date</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Payout Date</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Effective Date</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr ng-repeat="ProfileSalaryModel in profileSalaryList | filter : searchEmployeeID" tableload>
                                    <td>
                                        {{ProfileSalaryModel.employeeID}}  [{{ProfileSalaryModel.empName}}]
                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.salaryProfileID">
                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.employeeID">
                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.year">
                                    </td>
                                    <td> {{ProfileSalaryModel.year}}</td>

                                    <td>  
                                        {{(ProfileSalaryModel.ctc+ProfileSalaryModel.variablePay+ProfileSalaryModel.others)}}
                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.ctc">
                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.variablePay">
                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.others">

                                    </td>
                                    <td>
                                        <span class="badge badge-success" ng-if="ProfileSalaryModel.revisedPercent!=0"> 
                                            {{ProfileSalaryModel.revisedPercent}}%</span>
                                        <span class="badge badge-success" ng-if="ProfileSalaryModel.revisedPercent==0">  N/A</span>

                                    </td>
                                    <td>
                                        <input type="number" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.revisedNewPercent" class="col-sm-12">
                                    </td>
                                    <td> 
                                        {{(ProfileSalaryModel.ctc+ProfileSalaryModel.variablePay+ProfileSalaryModel.others) + (((ProfileSalaryModel.ctc+ProfileSalaryModel.variablePay+ProfileSalaryModel.others)/100)*ProfileSalaryModel.revisedPercent)}}

                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.selectedGroup">
                                    </td>
                                    <td>  
                                         <input type="date" date="DD-MM-YYYY" class="defaultTextBox" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.revisedDate">
    
                                    </td>

                                    <td>
                                        <input type="date" date="DD-MM-YYYY" class="defaultTextBox" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.payoutDate">

                                    </td>
                                    <td>
                                        <input type="date" date="DD-MM-YYYY" class="defaultTextBox" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.effectiveDate">
                                    </td>

                                      

                                </tr>

                            </tbody>
                        </table>



                            <table class="card p-6">
                                 
                                <tbody>
                                     
                                   
                                    <tr><td>&nbsp;</td></tr>
                                    
                                    <tr>
                                        <td class="col-sm-1"></td>
                                        <td class="col-sm-1"></td>
                                        <td class="col-sm-2"></td>
                                        <td class="col-sm-1"></td>

                                        <td>
                                            <div class="col-lg-1">
                                                <div class="payment-adress">

                                                    <button type="button" class="btn btn-primary waves-effect waves-light" aria-label="Product details" ng-click="SaveRevisedSalary(profileSalaryList)">
                                                        Save Revised Salary
                                                    </button>

                                                </div>
                                            </div>
                                        </td>
                                        <td class="col-sm-5"></td>

                                    </tr>
                                </tbody>
                            </table>


                       

                        <!-- / SUB CONTENT -->
                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>