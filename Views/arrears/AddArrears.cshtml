@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/ArrearsVal.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
      

}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="ArrearsApp" ng-controller="ArrearsController" ng-init="LoadAddArrears()">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Add Arrears </div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">


                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="tab-content">




                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">


                                <!-- USING THE GRID COMPLEX -->
                                <div class="col-12">
                                    <div class="example">
                                        <div class="description">
                                            <div class="description-text">
                                                <div class="row no-gutters align-items-center justify-content-between">

                                                    <div class="list-title text-muted">
                                                        <div class="alert alert-warning alert-dismissible fade show"
                                                             role="alert">
                                                            <button type="button" class="close" data-dismiss="alert"
                                                                    aria-label="Close">
                                                                <span aria-hidden="true">&times;</span>
                                                            </button>
                                                            You can process arrears for employee(s) by <strong>selecting employe from one list to another</strong> using arrow button and fill the details..
                                                        </div>

                                                    </div>


                                                </div>
                                            </div>
                                            <div class="toggle-source-preview">

                                            </div>
                                        </div>
                                        <div class="source-preview-wrapper">
                                            <div class="preview">
                                                <div class="preview-elements">
                                                    <div class="container">
                                                        <form>

                                                            <div class="row">

                                                                <div class="form-group col-md-8">
                                                                    <div class="row p-xl-1" ng-if="msg!=''">

                                                                        <div class="preview">
                                                                            <div class="preview-elements">
                                                                                <div class="alert alert-warning alert-dismissible fade show"
                                                                                     role="alert">
                                                                                    <button type="button" class="close" data-dismiss="alert"
                                                                                            aria-label="Close">
                                                                                        <span aria-hidden="true">&times;</span>
                                                                                    </button>
                                                                                    <strong>{{msg}}</strong>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>


                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>
                                                            </div>


                                                            <div class="row">
                                                                <div class="form-group col-md-5">
                                                                    <label class="col-form-label">
                                                                        All Employees
                                                                    </label>
                                                                    <select size="10" multiple ng-model="available" ng-options="EmployeeModel as EmployeeModel.employeeName for EmployeeModel in employeeList" style="width: 100%"></select>

                                                                </div>
                                                                <div class="form-group col-md-2">
                                                                    <div class="row">
                                                                        <div class="form-group col-md-12">Action<br /></div>


                                                                        <div class="col-md-12">
                                                                            <i class="icon icon-chevron-right text-blue " id="moveright" type="button" value="Add" ng-click="moveItem(available[0], employeeList,selectedclients)"></i>
                                                                        </div>

                                                                        <div class="col-md-12">
                                                                            <i class="icon icon-chevron-double-right text-blue " id="moverightall" type="button" value="Add All" ng-click="moveAll(employeeList,selectedclients)"></i>
                                                                        </div>

                                                                        <div class="col-md-12">
                                                                            <i class="icon icon-chevron-left text-brown " id="move left" type="button" value="Remove" ng-click="moveItem(selected[0], selectedclients,employeeList)"></i>
                                                                        </div>
                                                                        <div class="col-md-12">
                                                                            <i class="icon icon-chevron-double-left text-brown " id="moveleftall" type="button" value="Remove All" ng-click="moveAll(selectedclients,employeeList)"></i>
                                                                        </div>

                                                                    </div>


                                                                </div>
                                                                <div class="form-group col-md-5">
                                                                    <label class="col-form-label">Selected Employee</label>
                                                                    <select size="5" multiple ng-model="selected" ng-options="client as client.employeeName for client in selectedclients" style="width: 100%"></select>

                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Arrear Release Date</label>
                                                                    <input type="date" class="form-control" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.payoutReleaseDate">

                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Processing Year</label>


                                                                    <input type="text" class="form-control" name="ProfileSalaryModel.Year" ng-model="ProfileSalaryModel.year">

                                                                </div>
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Comments</label>


                                                                    <input type="text" class="form-control" name="ProfileSalaryModel.Comments" ng-model="ProfileSalaryModel.comments">

                                                                </div>
                                                            </div>




                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="SaveArrears(ProfileSalaryModel,selectedclients)">
                                                                        Process Arrears
                                                                    </button>

                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>

                                                            </div>

                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <!-- USING THE GRID COMPLEX -->


                            </div>


                            <!-- / SUB CONTENT -->



                        </div>

                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>
