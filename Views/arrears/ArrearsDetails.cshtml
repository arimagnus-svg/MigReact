@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/ArrearsVal.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>
      

}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="ArrearsApp" ng-controller="ArrearsController" ng-init="LoadArrears()">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Arrears Processing</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-auto">
                         <a href="/Arrears/AddArrears" class="btn btn-secondary">Process Arrear</a>

                     </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="page-content-card">
                        <span class="input-icon">
                            <i class="icon icon-account-search s-4 bigger-120"></i>
                            <input type="text" ng-model="searchEmployeeID" placeholder="Search by any field" class="input-small " />


                        </span>


                        <table id="formSummary-table" class="table dataTable">

                            <thead>

                                <tr>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employee ID</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employee Name</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Year</span>
                                        </div>
                                    </th>  

                                    
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Revised Percent</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title"> Effective Date</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Payout Release Date</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title"> Payout Date</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Status</span>
                                        </div>
                                    </th>
                                      
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Action</span>
                                        </div>
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr ng-repeat="ProfileSalaryModel in profileSalaryList | filter : searchEmployeeID" tableload>
                                    <td>
                                        {{ProfileSalaryModel.employeeID}}
                                        <input type="hidden" name="ProfileSalaryModel" ng-model="ProfileSalaryModel.salaryProfileID">
                                    </td>
                                    <td>{{ProfileSalaryModel.empName}}</td>

                                    <td>{{ProfileSalaryModel.year}}</td>
                                    <td> {{ProfileSalaryModel.revisedPercent}}</td>
                                    <td>{{ProfileSalaryModel.effectiveDate}}</td>
                                    <td> {{ProfileSalaryModel.payoutReleaseDate}}</td>
                                    <td>  {{ProfileSalaryModel.payoutDate}} </td>

                                    <td>
                                        {{ProfileSalaryModel.statusDesc}}
                                    </td> 

                                    

                                    <td>
                                        <a href="EditArrears/?EmployeeID={{ProfileSalaryModel.employeeID}}&&year={{ProfileSalaryModel.year}}">
                                            <i class="icon icon-pencil s-4"></i>
                                        </a>
                                         



                                    </td>

                                </tr>

                            </tbody>
                        </table>



                            <div class="contacts-list card">

                                

                                <div ng-if="profileSalaryList.length<1" class="p-10">

                                    <div class="alert alert-danger" role="alert">
                                        Arrear records not found..
                                    </div>
                                   
                                    <br />
                                    <p class="p-4" role="alert">
                                        <strong>   Poosible reasons</strong>
                                            <br />
                                            <label class="p-2"> There is no arrear processed for current year.</label>
                                            <br /><label class="p-2"> Technical error .. Contact support team.</label>

                                        </p>
                                   

                                </div>





                            </div>


                            <!-- / SUB CONTENT -->



                            
                        

                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>