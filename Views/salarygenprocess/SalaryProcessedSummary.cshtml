@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>
 
    <script src="~/lib/appJS/SalaryProcessVal.js"></script>



}



<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="SalaryProcessApp" ng-controller="SalaryProcessController" ng-init="LoadSalarySummary()">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Payroll Summary</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">

                        <label>Select Month</label>

                        <select class="form-control col-md-6" ng-model="Months" ng-change="LoadSalarySummarybyMonth(Months)" ng-init="Months=SelectedMonth">
                             
                            <option ng-repeat="(key, value)  in Months" value="{{key}}">
                                {{key}}
                            </option>


                        </select> 

                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content" >


                    <div class="tab-content">
                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">

                                <!-- CONTACT LIST HEADER -->
                                <div class="contacts-list-header p-4">

                                    <div class="row no-gutters align-items-center justify-content-between">

                                        <div class="list-title text-muted">
                                            <div class="alert alert-warning alert-dismissible fade show"
                                                 role="alert">
                                                <button type="button" class="close" data-dismiss="alert"
                                                        aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                                You can generate Payroll for the current month and update it by unlock the payroll for <strong>current month payroll</strong> only.
                                                <br /><strong> Prevoius months data can be viewed by selecting month from dropdown list  </strong>
                                            </div>



                                        </div>


                                    </div>

                                </div>
                                <!-- / CONTACT LIST HEADER -->
                                <!-- CONTACT ITEM -->
                                <div class="contact-item ripple  no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="ProfileSalarySummaryList.length>0" ng-repeat="ProfileAggSalaryModel in ProfileSalarySummaryList">

                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6">
                                        <div class="col-md-2 text-truncate font-weight-bold">Process Month </div>

                                        <div class="col-md-3 email text-truncate px-1 d-none d-xl-flex">
                                            {{SelectedMonth}}
                                        </div>

                                        <div class="col-md-1 text-truncate font-weight-bold" ng-if="ProfileAggSalaryModel.recordFound==1">Working Day </div>

                                        <div class="col-md-6 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.recordFound==1">
                                            {{ProfileAggSalaryModel.workingDay}} Days
                                        </div>
                                    </div>

                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="ProfileAggSalaryModel.recordFound==1">
                                        <div class="col-md-2 text-truncate font-weight-bold">Gross Amount </div>

                                        <div class="col-md-6 email text-truncate px-1 d-none d-xl-flex">
                                            {{ProfileAggSalaryModel.totalSalary}}

                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>
                                    </div>

                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="ProfileAggSalaryModel.recordFound==1">
                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue1>0">
                                            {{ProfileAggSalaryModel.group1}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue1>0">
                                            {{ProfileAggSalaryModel.groupValue1}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>
                                        </div>

                                        <div class="col-md-2 text-truncate font-weight-bold">Employee Count </div>

                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex">
                                            {{ProfileAggSalaryModel.employeeCount}}
                                        </div>

                                    </div>

                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="ProfileAggSalaryModel.recordFound==1">
                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue2>0">
                                            {{ProfileAggSalaryModel.group2}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue2>0">
                                            {{ProfileAggSalaryModel.groupValue2}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>
                                        </div>

                                        <div class="col-md-2 text-truncate font-weight-bold">Resignation Count</div>

                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex">
                                            {{ProfileAggSalaryModel.employeeResignCount}}
                                        </div>
                                    </div>

                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="(ProfileAggSalaryModel.groupValue3>0 || ProfileAggSalaryModel.groupValue4>0) && ProfileAggSalaryModel.recordFound==1">
                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue3>0">
                                            {{ProfileAggSalaryModel.group3}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue3>0">
                                            {{ProfileAggSalaryModel.groupValue3}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>

                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue4>0">
                                            {{ProfileAggSalaryModel.group4}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue4>0">
                                            {{ProfileAggSalaryModel.groupValue4}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>
                                    </div>
                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="(ProfileAggSalaryModel.groupValue5>0 || ProfileAggSalaryModel.groupValue6>0) && ProfileAggSalaryModel.recordFound==1">
                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue5>0">
                                            {{ProfileAggSalaryModel.group5}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue5>0">
                                            {{ProfileAggSalaryModel.groupValue5}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>

                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue6>0">
                                            {{ProfileAggSalaryModel.group6}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue6>0">
                                            {{ProfileAggSalaryModel.groupValue6}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>
                                    </div>

                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="(ProfileAggSalaryModel.groupValue7>0 || ProfileAggSalaryModel.groupValue8>0) && ProfileAggSalaryModel.recordFound==1">
                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue7>0">
                                            {{ProfileAggSalaryModel.group7}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue7>0">
                                            {{ProfileAggSalaryModel.groupValue7}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month=/{{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>

                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue8>0">
                                            {{ProfileAggSalaryModel.group8}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue8>0">
                                            {{ProfileAggSalaryModel.groupValue8}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>
                                    </div>

                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="(ProfileAggSalaryModel.groupValue9>0 || ProfileAggSalaryModel.groupValue10>0) && ProfileAggSalaryModel.recordFound==1">
                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue9>0">
                                            {{ProfileAggSalaryModel.group9}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue9>0">
                                            {{ProfileAggSalaryModel.groupValue9}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month=/{{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>

                                        <div class="col-md-2 phone text-truncate px-1 d-none d-xl-flex" ng-if="ProfileAggSalaryModel.groupValue10>0">
                                            {{ProfileAggSalaryModel.group10}}
                                        </div>
                                        <div class="col-md-4 company text-truncate px-1 d-none d-sm-flex" ng-if="ProfileAggSalaryModel.groupValue10>0">
                                            {{ProfileAggSalaryModel.groupValue10}}
                                            <a data-ng-href="@Url.Action("SalaryProcessedDetails", "SalaryGenProcess")?month=/{{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>

                                        </div>
                                    </div>


                                </div>

                                <!-- CONTACT ITEM -->







                            </div>


                            <!-- / SUB CONTENT -->

                            <div ng-if="ProfileSalarySummaryList.length>0">
                                <table class="card p-6" ng-if="ProfileSalarySummaryList[0].recordFound==0">
                                    <tr>
                                        <td>
                                            Salary information not found.
                                            <button type="button" class="btn btn-primary waves-effect waves-light" aria-label="Product details" ng-click="GeneratePayroll()">
                                                Generate Payroll
                                            </button>

                                        </td>
                                    </tr>
                                </table>


                            </div>
                            <div class="row p-xl-1" ng-if="msg!=''">

                                <div class="preview">
                                    <div class="preview-elements">
                                        <div class="alert alert-warning alert-dismissible fade show"
                                             role="alert">
                                            <button type="button" class="close" data-dismiss="alert"
                                                    aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <strong>{{msg}}</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div ng-if="ProfileSalarySummaryList.length>0">
                                <div class="card p-6" ng-if="ProfileSalarySummaryList[0].recordFound==1">
                                    <div class="contact-item ripple row no-gutters align-items-center py-1 px-1 py-sm-4 px-sm-2 jumbotron jumbotron-fluid">
                                        <div class="col-md-2">Payroll</div>
                                        <div class="col-md-6">
                                            <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="LockUnlockPayroll(SelectedMonth,'20')" ng-disabled="ProfileSalarySummaryList[0].payrollStatus==20">
                                                Lock
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="LockUnlockPayroll(SelectedMonth,'21')" ng-disabled="ProfileSalarySummaryList[0].payrollStatus==21">
                                                Unlock
                                            </button>
                                             
                                        </div>
                                    </div>
                                    <div class="divider"></div>
                                    <div class="contact-item ripple row no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6 jumbotron jumbotron-fluid">

                                        <div class="col-md-3">Employee View</div>

                                        <div class="col-md-9">
                                            <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="lockUnlockPayrollEmpView(SelectedMonth,'22')" ng-disabled="ProfileSalarySummaryList[0].empViewStatus==22">
                                                Lock
                                            </button>
                                            <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="lockUnlockPayrollEmpView(SelectedMonth,'23')" ng-disabled="ProfileSalarySummaryList[0].empViewStatus==23">
                                                Unlock
                                            </button>

                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    
                    </div>
                    </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>