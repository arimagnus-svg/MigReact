@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/SalaryProcessVal.js"></script>


}

<div class="content-wrapper">

    <div class="content" ng-app="SalaryProcessApp">
        <div class="source-preview-wrapper">
            <div class="preview">
                <div class="preview-elements">

                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Auth/Home">Home</a></li>
                        <li class="breadcrumb-item"><a href="/SalaryGenProcess/SalaryProcessedSummary">Payroll Summary</a></li>
                    </ol>
                </div>
            </div>
        </div>
        <div id="e-commerce-product" class="page-layout simple tabbed" ng-controller="SalaryProcessController" ng-init="EditSalaryGenbyID('@Html.Raw(ViewBag.Action)','@Html.Raw(ViewBag.Message)')">

            <!-- HEADER -->
            <div class="page-header bg-primary text-auto row no-gutters align-items-center justify-content-between p-2" >


                <div class="col-sm-6">
                    <div class="row p-xl-1">
                            <div class="col-sm-2">
                                <label>Emp ID</label>
                            </div>
                            <div class="col-sm-4">
                                <label>{{ProfileSalaryModel.employeeID}} </label>
                            </div>
                            <div class="col-sm-3">
                                <label> Employee Name</label>
                             </div>
                            <div class="col-sm-3">
                                <label>
                                    {{ProfileSalaryModel.empName}}
                                </label>
                            </div>
                    </div>
                </div>

                <div class="col-sm-6">

                    <div class="row p-xl-1">
                        <div class="col-sm-4">
                            <label class="pull-right">Financial Year</label>
                        </div>
                        <div class="col-sm-4">
                            <label>
                                {{ProfileSalaryModel.year}}
                            </label>
                        </div>
                        <div class="col-sm-2">
                            <label> </label>
                        </div>
                        <div class="col-sm-2">
                            <label>
                             </label>
                        </div>
                    </div>
                </div>



            </div>
            <!-- / HEADER -->
            <!-- CONTENT -->
            <div class="page-content" >

                <ul class="nav nav-tabs" id="myTab" role="tablist">

                    <li class="nav-item">
                        <a class="nav-link btn active" id="basic-info-tab" data-toggle="tab"
                           href="#basic-info-tab-pane"
                           role="tab" aria-controls="basic-info-tab-pane" aria-expanded="true">
                            Employee Salary details
                        </a>
                    </li>

                   

                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="basic-info-tab-pane" role="tabpanel"
                         aria-labelledby="basic-info-tab">

                        <div class="card p-6">

                            <div class="row p-xl-1 bg-grey-300">
                                <div class="col-6">
                                    Salary Component
                                </div>
                                <div class="col-3">
                                    Amount
                                </div>
                                <div class="col-3">
                                    Days
                                </div>
                            </div>


                            <!-- GROUP Details -->

                            <div class="col-12" ng-repeat="ProfileMonthlySalaryModel in ProfileMonthlySalaryList">
                                <div class="source-preview-wrapper">
                                    <div class="row p-xl-1 div-border" ng-if="$index==0">
                                        <div class="col-3 ">
                                            <strong>
                                                Month :   {{SelectedMonth}}
                                            </strong>
                                        </div>
                                        <div class="col-9">


                                        </div>
                                    </div>
                                    <div class="row p-xl-1 div-border">
                                        <div class="col-5">
                                            {{ProfileMonthlySalaryModel.sectionName}}
                                            <input type="hidden" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.sectionName" readonly>
                                            <input type="hidden" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.sectionID" readonly>

                                        </div>
                                        <div class="col-1">
                                        </div>
                                        <div class="col-3">
                                            <input type="text" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.totalValue" class="defaultTextBox">
                                            <input type="hidden" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.profileEmpSalaryDrillID" readonly>
                                            <input type="hidden" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.salaryProfileID" readonly>
                                        </div>

                                        <div class="col-3">
                                            <input type="text" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.totalDays" class="defaultTextBox">
                                            <input type="hidden" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.employeeID" readonly>
                                            <input type="hidden" name="ProfileMonthlySalaryModel" ng-model="ProfileMonthlySalaryModel.masterGroup" readonly>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="col-12 form-check has-danger" ng-if="ProfileMonthlySalaryList.length<=0">

                                <br />
                                <label class="form-check-label"><span>Salary details not found</span></label>
                            </div>
                            <!-- GROUP Details end -->





                        </div>
                    </div>
                    <div class="tab-pane fade" id="product-images-tab-pane" role="tabpanel"
                         aria-labelledby="product-images-tab">



                    </div>
                    <div class="row p-xl-1" />


                    <div class="row" ng-if="ProfileMonthlySalaryList.length>0">
                        <div class="col-lg-5">
                            <div class="payment-adress">

                                <button type="button" class="btn btn-primary waves-effect waves-light" aria-label="Product details" ng-click="UpdateSalary(ProfileSalaryModel,ProfileMonthlySalaryList)">
                                    Update Salary
                                </button>

                            </div>
                        </div>
                        <div class="col-lg-4">
                            <button type="button" class="btn btn-primary waves-effect waves-light" aria-label="Product details" ng-click="RegenerateSalary(ProfileMonthlySalaryList)">
                                Recalculate Salary
                            </button>
                        </div>
                    </div>

                    <div class="row p-xl-1" ng-if="msg!=''">

                        <div class="preview">
                            <div class="preview-elements">
                                <div class="alert alert-warning alert-dismissible fade show"
                                     role="alert">
                                    <button type="button" class="close" data-dismiss="alert"
                                            aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                    <strong>{{msg}}</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <!-- / CONTENT -->
        </div>

    </div>

</div>