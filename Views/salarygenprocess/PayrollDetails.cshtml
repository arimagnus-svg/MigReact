@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>
 
    <script src="~/lib/appJS/SalaryProcessVal.js"></script>



}



<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="SalaryProcessApp" ng-controller="SalaryProcessController" ng-init="ShowPayrollData('@Html.Raw(ViewBag.Message)')">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm d-print-none">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Employee Payroll Details</div>
                             </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2 d-print-none">

                        <label>Select Month</label>
                         
                        <select class="form-control col-md-6" ng-model="Months" ng-change="ShowPayrollData(Months)">
                            <option ng-repeat="(key, value)  in Months" value="{{key}}">
                                {{key}}
                            </option>
                        </select>

                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="tab-content">
                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">

                                <!-- CONTACT LIST HEADER -->
                                <div class="contacts-list-header p-4">

                                    <div class="row no-gutters align-items-center justify-content-between">

                                        <div class="list-title text-muted" ng-if="ProfileMonthlySalaryList.length>0">
                                             
                                            <img alt="Logo" src="{{empDetails.companyImage}}">
                                        </div>


                                    </div>

                                </div>
                                <!-- / CONTACT LIST HEADER -->
                                <!-- CONTACT ITEM -->
                                <div class="contact-item ripple  no-gutters align-items-center py-2 px-3 py-sm-4 px-sm-6" ng-if="ProfileMonthlySalaryList.length>0">

                                    <div class="col-12">
                                        <div class="source-preview-wrapper">
                                            <div class="row p-xl-1 ">
                                                <div class="col-3">
                                                  
                                                    
                                                    {{empDetails.companyName}}
                                                    <br />
                                                    {{empDetails.companyAddress}}


                                                </div>
                                                <div class="col-6">
                                                    
                                                </div>
                                                <div class="col-3">
                                                    Payslip for {{SelectedMonth}}
                                                </div>
                                            </div>

                                            <div class="row p-xl-1 "> &nbsp;</div>

                                        </div>
                                    </div>

                                    <!-- EMP Details -->

                                    <div class="col-12">
                                        <div class="source-preview-wrapper">
                                            <div class="row p-xl-1 div-border">
                                                <div class="col-3 bg-grey">
                                                    Employee ID
                                                   
                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.employeeID}}
                                                </div>
                                                <div class="col-3 bg-grey">
                                                    Employee Name
                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.employeeName}}
                                                </div>
                                            </div>

                                            <div class="row p-xl-1 div-border">
                                                <div class="col-3 bg-grey">
                                                    Date of Join

                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.doj}}
                                                </div>
                                                <div class="col-3 bg-grey">
                                                    Department
                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.baseCostCode}}
                                                </div>
                                            </div>
                                            <div class="row p-xl-1 div-border">
                                                <div class="col-3 bg-grey">
                                                    Gender

                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.gender}}
                                                </div>
                                                <div class="col-3 bg-grey">
                                                    Designation
                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.jobTitle}}
                                                </div>
                                            </div>
                                            <div class="row p-xl-1 div-border">
                                                <div class="col-3 bg-grey">
                                                    PAN

                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.paNno}}
                                                </div>
                                                <div class="col-3 bg-grey">
                                                    PF Account No
                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.pFno}}
                                                </div>
                                            </div>
                                            <div class="row p-xl-1 div-border">
                                                <div class="col-3 bg-grey">
                                                    Bank Name

                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.bankName}}
                                                </div>
                                                <div class="col-3 bg-grey">
                                                    Bank Account No
                                                </div>
                                                <div class="col-3">
                                                    {{empDetails.bankAccount}}
                                                </div>
                                            </div>

                                        </div>
                                    </div>


                                    <!-- EMP Details end -->
                                    <div class="col-12"> &nbsp; </div>
                                    <div class="col-12"> &nbsp;   </div>

                                    <!-- GROUP Details -->

                                    <div class="col-12">
                                        <div class="source-preview-wrapper">
                                            <div class="row p-xl-1 div-border bg-grey">
                                                <div class="col-4">
                                                    Earnings
                                                </div>
                                                <div class="col-2">
                                                    Amount
                                                </div>

                                                <div class="col-4">
                                                    Detections
                                                </div>
                                                <div class="col-2">
                                                    Amount
                                                </div>

                                            </div>
                                            
                                            <div class="row p-xl-1 div-border" ng-repeat="MonthlyPayrollValueModel in payrollValues">
                                                <div class="col-4" >
                                                    {{MonthlyPayrollValueModel.sectionName1}}

                                                </div>
                                                <div class="col-2" ng-if="MonthlyPayrollValueModel.totalValue1>0">
                                                    {{MonthlyPayrollValueModel.totalValue1}}

                                                </div>
                                                <div class="col-2" ng-if="MonthlyPayrollValueModel.totalValue1<1">

                                                </div>
                                                <div class="col-4">
                                                    {{MonthlyPayrollValueModel.sectionName2}}
                                                    <input type="hidden" name="MonthlyPayrollValueModel" ng-model="ProfileMonthlySalaryModel.employeeID" readonly>

                                                </div>
                                                <div class="col-2" ng-if="MonthlyPayrollValueModel.totalValue2>0">
                                                    {{MonthlyPayrollValueModel.totalValue2}}

                                                </div>
                                                <div class="col-2" ng-if="MonthlyPayrollValueModel.totalValue2<1">

                                                </div>
                                            </div>


                                        </div>
                                    </div>
                                    <div class="col-12"> &nbsp; </div>
                                    <div class="col-12 form-check has-danger" ng-if="ProfileMonthlySalaryList.length>0">

                                        Amount in Words: {{MonthlySalaryList.salWord}} rupees only.
                                    </div>
                                    <div class="col-12"> &nbsp; </div>                                   
                                    <div class="col-12"> &nbsp; </div>

                                    <div class="col-12 form-check has-danger" ng-if="ProfileMonthlySalaryList.length>0">

                                        <h10>  {{MonthlySalaryList.salDisclaim}}</h10>
                                    </div>
                                    <div class="col-12"> &nbsp; </div>

                                    <div class="col-12 form-check has-danger d-print-none">

                                        <button type="button" class="btn btn-primary pull-right" style="margin-right: 5px; " onclick="javascript:window.print();">
                                            <i class="fa fa-print"></i> Print
                                        </button>
                                    </div>

                                    <!-- GROUP Details end -->

                                </div>
                                
                                <div class="col-12 form-check has-danger" ng-if="ProfileMonthlySalaryList.length<=0">

                                    <br />
                                    <label class="form-check-label"><span>Salary details not found</span></label>
                                </div>
                                <!-- CONTACT ITEM -->







                            </div>


                            <!-- / SUB CONTENT -->

                            <div ng-if="ProfileSalarySummaryList.length>0">
                                <table class="card p-6" ng-if="ProfileSalarySummaryList[0].recordFound==0">
                                    <tr>
                                        <td>
                                            Salary information not found.
                                          
                                        </td>
                                    </tr>
                                </table>


                            </div>

                            
                        </div>

                    </div>
                </div>
                    
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


</div>