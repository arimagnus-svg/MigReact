@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>
    <script type="text/javascript" src="~/lib/js/FileSaver.js"></script>

    <script src="~/lib/appJS/SalaryProcessVal.js"></script>



}



<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="SalaryProcessApp" ng-controller="SalaryProcessController" ng-init="LoadSalaryProcessSetup('@Html.Raw(ViewBag.Action)')">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Employee Payroll Details</div>
                                <div class="">Month :{{SelectedMonth}}</div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">

                        <label>Select Month</label>

                        <select class="form-control col-md-6" ng-model="Months" ng-change="LoadSalaryProcessSetup(Months)">
                            <option ng-repeat="(key, value)  in Months" value="{{key}}">
                                {{key}}
                            </option>
                        </select>

                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="page-content-card">
                        

                        <span class="input-icon">
                            <i class="icon icon-account-search s-4 bigger-120"></i>
                            <input type="text" ng-model="searchEmployeeID" placeholder="Search by any field" class="input-small " />


                        </span>



                        <table id="formSummary-table" class="table dataTable">

                            <thead>

                                <tr>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employee ID</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Employee Name</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Group1 Value</span>
                                        </div>
                                    </th>

                                   
                                    
                                    
                                    
                                    

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Group2 Value</span>
                                        </div>
                                    </th>

                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Total Pay</span>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="table-header">
                                            <span class="column-title">Action</span>
                                        </div>
                                    </th>
                                      
                                </tr>
                            </thead>

                            <tbody>

                                <tr ng-repeat="ProfileAggSalaryModel in ProfileSalarySummaryList| filter : searchEmployeeID" tableload>
                                    <td>
                                        {{ProfileAggSalaryModel.employeeID}}
                                    </td>
                                    <td> {{ProfileAggSalaryModel.employeeName}}</td>

                                   
                                   
                                    <td> 
                                        {{ProfileAggSalaryModel.group2}} :
                                        {{ProfileAggSalaryModel.groupValue2}}
                                    </td>
                                    <td>
                                        {{ProfileAggSalaryModel.group1}} :
                                        {{ProfileAggSalaryModel.groupValue1}}

                                    </td>
                                    <td>
                                        <span class="badge badge-info"> NET PAY: </span> {{ProfileAggSalaryModel.totalSalary}}
                                    </td>
                                     

                                    <td>
                                        <a data-ng-href="@Url.Action("EditEmpGenSalary", "SalaryGenProcess")?EmployeeID={{ProfileAggSalaryModel.employeeID}}&&Month={{SelectedMonth}}"> <i class="icon icon-pencil s-4"></i>  </a>


                                    </td>

                                </tr>

                            </tbody>
                        </table>

                         



                            <table class="card p-6" ng-if="ProfileMonthlySalaryList.length>0" id="formSummary-table">
                                
                                <tbody>
                                   
                                    <tr class="row p-xl-1" ng-if="msg!=''">

                                        <td class="preview">

                                            <button type="button" class="close" data-dismiss="alert"
                                                    aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                            <strong>{{msg}}</strong>

                                        </td>


                                    </tr>
                                    <tr><td>&nbsp;</td></tr>
                                    

                                </tbody>
                            </table>

                            <div>
                                <button ng-click="DownloadExcel(ProfileSalarySummaryList)">Export to Excel</button>


                            </div>


                        

                        <!-- / SUB CONTENT -->
                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>