@section scripts{
    <script src="~/lib/angular.js"></script>
    <script src="~/lib/ui-bootstrap-tpls-2.5.0.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/lib/js/popper.js/index.js"></script>

    <script src="~/lib/appJS/TaxRegimeSetup.js"></script>

    <script src="~/lib/angular-drag-and-drop-lists.js"></script>


}


<div class="content-wrapper">

    <div class="content">
        <div id="e-commerce-products" class="page-layout carded full-width">

            <div class="top-bg bg-primary"></div>

            <!-- CONTENT -->
            <div class="page-content" ng-app="TaxRegimeApp" ng-controller="TaxRegimeController" ng-init="LoadTaxRegimeEdit('@Html.Raw(ViewBag.Action)')">

                <!-- HEADER -->
                <div class="header bg-primary text-auto row no-gutters align-items-center justify-content-between">

                    <!-- APP TITLE -->
                    <div class="col-10 col-sm">

                        <div class="logo row no-gutters align-items-start">
                            <div class="logo-icon mr-3 mt-1">
                                <i class="icon-cube-outline s-6"></i>
                            </div>
                            <div class="logo-text">
                                <div class="h4">Tax Regime Selection</div>
                                <div class=""></div>
                            </div>
                        </div>

                    </div>
                    <!-- / APP TITLE -->


                    <div class="col-2">


                    </div>

                </div>
                <!-- / HEADER -->
                <!-- CONTENT -->
                <div class="page-content">


                    <div class="tab-content">




                        <div class="row tab-pane fade show active">


                            <div class="contacts-list card">


                                <!-- USING THE GRID COMPLEX -->
                                <div class="col-12">
                                    <div class="example">
                                        <div class="description">
                                            <div class="description-text">
                                                <div class="row no-gutters align-items-center justify-content-between">

                                                    <div class="list-title text-muted">
                                                        <div class="row p-xl-1" ng-if="msg!=''">

                                                            <div class="preview">
                                                                <div class="preview-elements">
                                                                    <div class="alert alert-warning alert-dismissible fade show"
                                                                         role="alert">
                                                                        <button type="button" class="close" data-dismiss="alert"
                                                                                aria-label="Close">
                                                                            <span aria-hidden="true">&times;</span>
                                                                        </button>
                                                                        <strong>{{msg}}</strong>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                    </div>


                                                </div>
                                            </div>
                                            <div class="toggle-source-preview">

                                            </div>
                                        </div>
                                        <div class="source-preview-wrapper">
                                            <div class="preview">
                                                <div class="preview-elements">
                                                    <div class="container">
                                                        <form>


                                                            <div class="row">

                                                                <div class="form-group col-md-5">
                                                                    <label class="col-form-label">Choose the Tax Rate(Regime)</label>

                                                                    <input type="radio"
                                                                           name="TaxRegimeName"
                                                                           ng-model="TaxRegimeModel.taxRegimeName"
                                                                           value="Old_Tax_Regime" ng-checked="TaxRegimeModel.taxRegimeName!='New_Tax_Regime'" /> Old Regime
                                                                    &nbsp;  &nbsp;
                                                                    <input type="radio"
                                                                           name="TaxRegimeName"
                                                                           ng-model="TaxRegimeModel.taxRegimeName"
                                                                           value="New_Tax_Regime" ng-checked="TaxRegimeModel.taxRegimeName=='New_Tax_Regime'" /> New Regime

                                                                </div>
                                                                <div class="form-group col-md-7">
                                                                    <label class="col-form-label"><strong>Notes:</strong></label>
                                                                    <label class="col-form-label text-black">- Old Tax regime indicates Old tax rate and new Tax regime indicates new tax rate </label>

                                                                    <label class="col-form-label text-black">- An individual has an option to opt for the old tax regime in any financial year, provided there is no business income</label>

                                                                    <label class="col-form-label text-black">- Its Employee responsibility to choose the tax regime . By default ,Old Tax regime (Old tax rate) will be assigned if employeed didnt select any regime </label>

                                                                    <label class="col-form-label text-black">- Once the regime is selected , it will be frozen for the current financial year and tax will be calculated based on that. </label>

                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <label class="col-form-label">Last Updated Date : {{TaxRegimeModel.lastModifiedDate}}</label>

                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>
                                                            </div>


                                                            <div class="row">
                                                                <div class="form-group col-md-4">
                                                                    <button type="button" class="btn btn-outline-primary" aria-label="Product details" ng-click="SaveTaxRegimeSel(TaxRegimeModel)">
                                                                        Update
                                                                    </button>

                                                                </div>
                                                                <div class="form-group col-md-4">

                                                                </div>

                                                            </div>


                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <!-- USING THE GRID COMPLEX -->



                            </div>


                            <!-- / SUB CONTENT -->



                        </div>

                    </div>
                </div>
                <!-- / CONTENT -->
            </div>

        </div>


    </div>
</div>